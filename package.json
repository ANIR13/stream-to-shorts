{
  "name": "stream-to-shorts",
  "version": "1.0.0",
  "description": "Open-source, privacy-first desktop application that turns long livestream recordings into vertical YouTube Shorts, TikToks and Instagram Reels with automated highlights, offline transcription and animated captions.",
  "private": true,
  "license": "MIT",
  "author": "ANIR13",
  "homepage": "https://github.com/ANIR13/stream-to-shorts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANIR13/stream-to-shorts.git"
  },
  "bugs": {
    "url": "https://github.com/ANIR13/stream-to-shorts/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/mastersrecipes"
  },
  "main": "app/server.js",
  "scripts": {
    "start": "node app/server.js",
    "test": "node scripts/run-tests.js",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "test:e2e": "node scripts/run-tests.js e2e",
    "test:regression": "node scripts/run-tests.js regression",
    "check": "node scripts/check-syntax.js",
    "check:release": "node scripts/check-release.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "linux"
  ],
  "keywords": [
    "video-editing",
    "shorts",
    "tiktok",
    "youtube-shorts",
    "instagram-reels",
    "ffmpeg",
    "whisper",
    "nodejs",
    "open-source",
    "offline-first",
    "video-automation",
    "captions",
    "stream",
    "twitch"
  ]
}
